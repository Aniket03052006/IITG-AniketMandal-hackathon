# Copy to .env (never commit .env). All keys are optional; defaults work for the demo.
# Config directory and fixtures can be relocated:
# EVENTSHOCK_CONFIG_DIR=configs
# EVENTSHOCK_FIXTURES_DIR=data/fixtures
# Override the stress trigger threshold from configs/app.yaml (1-10):
# EVENTSHOCK_TRIGGER_THRESHOLD=7
# Origins allowed to call the API from a browser (Vite dev server by default):
# EVENTSHOCK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Built UI directory served by the API at /:
# EVENTSHOCK_WEB_DIST_DIR=web/dist
#
# Later stages (not used yet): provider keys live here, e.g. NEWSAPI_KEY, ALPHAVANTAGE_KEY.

# Data profile: replay (default; frozen real-source pack run through the ingestion pipeline) or demo (Stage-1 fixtures).
# EVENTSHOCK_PROFILE=replay
# Use a different (e.g. freshly fetched and frozen) snapshot directory:
# EVENTSHOCK_REPLAY_DIR=data/replay
# Use a different trained sentiment / event model directory (each must hold model.joblib + model_card.json; the server refuses to start otherwise):
# EVENTSHOCK_SENTIMENT_MODEL_DIR=models/sentiment/tfidf-lr-v1
# EVENTSHOCK_EVENT_MODEL_DIR=models/event/tfidf-lr-event-v1

# SEC EDGAR fair-access policy: a declared contact (your email) goes into the User-Agent of `make fetch-edgar`. Required for that target only.
# EVENTSHOCK_SEC_CONTACT=you@example.com

# Live information (off by default). `make run-live` sets EVENTSHOCK_LIVE=1 and polls GDELT DOC 2.0 (network, no key needed).
# EVENTSHOCK_LIVE=1
# EVENTSHOCK_LIVE_SOURCE=capture   # replay data/live/sample_capture.jsonl as if live (offline); `make run-capture`
# EVENTSHOCK_JOURNAL_PATH=data/live/journal.jsonl   # raw live/pasted inputs, git-ignored
# EVENTSHOCK_OVERRIDES_PATH=data/live/overrides/overrides.json   # your manual adjustments of the side-cars, git-ignored

# Risk assessment: how new text (a paste, the live feed) is read. OFF by default: without a key, or with EVENTSHOCK_LLM unset, deterministic rules read it
# ("rule-based demo mode", labelled in the UI) and nothing leaves this machine. Turning it on sends the report text (capped at 2,000 characters) to the provider.
# Keys are read from the environment / .env only; never put one in a config file or commit it (.env is git-ignored).
# EVENTSHOCK_LLM=1                                   # `make run-llm` sets this
# EVENTSHOCK_LLM_PROVIDER=groq                       # groq (default in configs/llm.yaml) | anthropic
# GROQ_API_KEY=gsk_...                               # https://console.groq.com/keys
# ANTHROPIC_API_KEY=sk-ant-...
# EVENTSHOCK_LLM_MODEL=openai/gpt-oss-120b           # overrides configs/llm.yaml; list what a Groq key can use: GET https://api.groq.com/openai/v1/models
# EVENTSHOCK_LLM_CACHE_PATH=data/live/llm_cache.jsonl  # answers are cached by text + model + prompt version, so the same text is never sent twice

# Decision intelligence (Stage 12). Monitor state, watchlists, scenario results and feedback are stored here (git-ignored); tests redirect it.
# EVENTSHOCK_DECISION_STORE_PATH=data/live/decision

# External markets (Stage 12): what an independent prediction market (Kalshi, public, no key) prices. An observation shown beside the risk view, never an input to it.
#   snapshot (default) reads the captured, hash-pinned data/external/kalshi_snapshot.json (`make kalshi-snapshot` re-captures it; network, no key)
#   fixture            reads SYNTHETIC labelled markets for tests and demos (`make market-fixtures`)
#   live               asks Kalshi's public API (rate limited; any failure becomes "External market data unavailable.")
#   off                no external market data
# EVENTSHOCK_MARKETS=snapshot
# EVENTSHOCK_KALSHI_SNAPSHOT_PATH=data/external/kalshi_snapshot.json
# EVENTSHOCK_MARKETS_FIXTURE_PATH=data/fixtures/external_markets/markets.json
